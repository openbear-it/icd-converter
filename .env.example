# ICD Converter – environment variables
# Copy this file to .env and fill in the values.

# HTTP port (default: 8080)
PORT=8080

# Path to the SQLite database file (default: icd.db)
ICD_DB_PATH=icd.db

# Gin mode: "release" (default when unset) or "debug"
GIN_MODE=release

# ── Semantic Embedding Search ─────────────────────────────────
# Leave LLM_EMBED_MODEL empty to fall back to heuristic keyword search.
# Recommended models (via Ollama):
#   nomic-embed-text  – 768 dim, ~274 MB, best quality
#   all-minilm        – 384 dim, ~45 MB, fastest
LLM_EMBED_BASE_URL=http://localhost:11434/v1
LLM_EMBED_API_KEY=ollama
LLM_EMBED_MODEL=nomic-embed-text
